# Example: Thomson construction result for regex {a|b}abb

alphabet: {a, b} # Optional, can be omitted
states: {q0, q1, q2, q3, q4, q5, q6} # Optional, can be omitted
start: q0
accepting: {q6}

# Transition format: from symbol -> to
# For epsilon, use ε or eps

transitions:
  q0 -ε-> q1
  q0 -ε-> q3
  q1 -a-> q2
  q2 -ε-> q7
  q3 -b-> q4
  q4 -ε-> q7
  q7 -a-> q8
  q8 -b-> q9
  q9 -b-> q10
  q10 -ε-> q6