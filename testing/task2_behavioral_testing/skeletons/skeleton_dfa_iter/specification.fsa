# TODO: Navrhnite deterministický konečnostavový automat (DFA) ekvivalentný zadanému regulárnemu výrazu a jeho formálnu špecifikáciu zapíšte do tohto súboru.
# Súbor bude automaticky spracovaný a porovnaný s referenčným riešením.
#
# Nižšie uvedený príklad formálnej špecifikácie DFA použite ako šablónu a upravte ho tak, aby zodpovedal vášmu riešeniu.

alphabet: {a, b}

states: {
    q0=".ab",
    q1="a.b",
    q2="ab."
}

initial_state: q0
accepting_states: {q2}

transitions: {
    q0 -a-> q1,
    q1 -b-> q2
}