#-------------------------------------------------------------------------------
# FSA ASSIGNMENTS - ENVIRONMENT CONFIGURATION
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# QUESTION GENERATION
#-------------------------------------------------------------------------------

# Quiz category name in Moodle
QUIZ_CATEGORY="Zapoctovka A/prakticka cast"

# Number of questions to generate
NUMBER_OF_QUESTIONS=10

# Regex difficulty control (number of states)
REGEX_MIN_STATES_COUNT=4
REGEX_MAX_STATES_COUNT=4

# Type of automaton, there are three options: "dfa", "nfa", "any"
AUTOMATON_TYPE="any"

# Type of implementation, there are three options: "iterative", "recursive", "any"
IMPLEMENTATION_TYPE="any"

# Max and min number of distinct symbols allowed in generated regexes
MAX_ALPHABET_SIZE=3
MIN_ALPHABET_SIZE=3

#-------------------------------------------------------------------------------
# QUESTION PROPERTIES & EVALUATION SETTINGS
#-------------------------------------------------------------------------------

# Report title/name
REPORT_TITLE="FSA Credit Test A"

#Max points that could be received from assignment
ASSIGNMENT_MAX_POINTS=7

# Test configuration
TEST_WORDS_COUNT=30
BAD_WORD_RATIO_LEVEL=0.4
GROUP_SIZE=5

# DKA (Deterministic Finite Automaton) scoring
DKA_FSA_ISOMORPHISM=30
DKA_FSA_ANNOTATIONS=10
DKA_IMPLEMENTATION=60

# NKA (Nondeterministic Finite Automaton) scoring
NKA_FSA_ISOMORPHISM=30
NKA_IMPLEMENTATION=70


#-------------------------------------------------------------------------------
# MOODLE SETTINGS
#-------------------------------------------------------------------------------

# Moodle credentials
MOODLE_USERNAME="admin"
MOODLE_PASSWORD="1234"

# Moodle assignment link
ASSIGNMENT_LINK="https://moodle.fei.tuke.sk/mod/quiz/view.php?id=14374"

# Question number to evaluate
QUESTION_NUMBER=1

